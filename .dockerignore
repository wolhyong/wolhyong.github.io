# ============================================
# Docker 빌드 컨텍스트 제외 목록
# ============================================

# 버전 관리
.git
.gitignore

# 빌드 결과물
_site/
.jekyll-cache/

# Node.js
node_modules/
package-lock.json

# Python 스크립트
__pycache__/
*.pyc
*.pyo
*.py

# 기타 개발 파일 (루트에만 적용)
/*.md
/*.mjs

# 포스트 파일은 포함 (제외하지 않음)
# _posts/ 디렉토리의 *.md 파일은 Jekyll 빌드에 필요

# 로컬 환경
.env
.env.local

# OS 파일
.DS_Store
Thumbs.db
